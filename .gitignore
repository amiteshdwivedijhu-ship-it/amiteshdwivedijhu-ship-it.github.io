npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Generated by scripts/sync.mjs and COMMITTED on purpose.
#   public/demos/**      demo assets copied from each project
#   src/content/**       artifact and report markdown
#   src/data/**          scorecard JSON the results tables are built from
# Cloudflare builds from this repo alone and never sees the source projects, so
# ignoring these would deploy a site with no demos and no numbers. They are build
# inputs, not authored files: never edit them here, edit the project and re-sync.
# `npm run sync:check` fails if they have drifted from source.

# Guardrail: nothing large belongs in this repo. The heavy reproducibility
# artifacts (10-K's llm.sqlite, parsed filings) stay in the PROJECT repos, which
# commit them on purpose so a reviewer can re-run the evals with no API key.
*.sqlite
*.npz
