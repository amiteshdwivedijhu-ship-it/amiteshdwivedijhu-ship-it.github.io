---
import "../styles/house.css";
import { PROJECTS } from "../lib/site";
import Icon from "../components/Icon.astro";
interface Props { title: string; description?: string; }
const { title, description = "Amitesh Dwivedi. AI product manager. Agentic AI in healthcare, and working prototypes with the evidence attached." } = Astro.props;
const path = Astro.url.pathname;
const activeProject = PROJECTS.find((project) => path.includes(`/${project.slug}`));
const socialImage = new URL("/og.png", Astro.site ?? Astro.url.origin).toString();
const on = (test: boolean) => (test ? "page" : undefined);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:alt" content="Amitesh Dwivedi. High-stakes AI, measured before it ships." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />
  <meta name="theme-color" content="#f2efe3" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23f2efe3'/%3E%3Crect x='7' y='7' width='18' height='18' fill='%23e2361a'/%3E%3C/svg%3E" />
  <script is:inline>
    /* Content is visible by default. The gesture is added only where it is welcome. */
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.dataset.motion = "on";
    }
  </script>
</head>
<body>
<!--
  THESIS: Every colour on this site is a measurement. The finding of each project
  is drawn as a poster whose shapes are its numbers, refusing the dark-glass
  AI-portfolio hero and its cream-and-serif opposite.
  OWN-WORLD: Cut paper on bone. Archivo run wide and heavy, Chivo Mono for
  measured figures only, hairline-ruled full-bleed bands, drenched vermilion /
  chrome / cobalt / viridian fields, no gradient, blur, or shadow anywhere.
  STORY: A hiring manager sees three shipped AI products, reads one measured
  figure each, and finds every number traced to a committed artifact.
  FIRST VIEWPORT: Bone ground, the locked sentence set to the full width in
  heavy Archivo with a vermilion cut for its full stop, the gate rule drawing
  beneath it, two pills at the left, three colour fields breaking the fold.
  FORM: Fletcher wit poster fused with the tolans panel grammar. Candidate 1 of
  7, brief-pinned over assigned candidate 6; seed key e3b25340.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the
  finish review, the verdict, DESIGN.md, and every shipping raster carrying its
  provenance.
-->
  <a class="skip" href="#main">Skip to content</a>

  <nav class="nav" aria-label="Global">
    <div class="inner">
      <a class="wordmark" href="/">Amitesh Dwivedi</a>
      <a class="pill" href="/#work" aria-current={on(path === "/")}>Work</a>
      <a class="pill" href="/resume/" aria-current={on(path.startsWith("/resume"))}><Icon name="resume" size={16} />Resume</a>
            <a class="pill" href="https://linkedin.com/in/amiteshdwivedi/" rel="me noopener" target="_blank"><Icon name="linkedin" size={16} />LinkedIn</a>
      <a class="pill" href="https://github.com/amiteshdwivedijhu-ship-it" rel="me noopener" target="_blank"><Icon name="github" size={16} />GitHub</a>
      <a class="pill" href="mailto:amitesh.dwivedi.jhu@gmail.com"><Icon name="letter" size={16} />Email</a>
    </div>
  </nav>

  {activeProject && (
    <nav class="rail-nav" aria-label={`${activeProject.name}`}>
      <div class="inner">
        <a class="here" href={`/projects/${activeProject.slug}/`}>{activeProject.name}</a>
        <a href={`/projects/${activeProject.slug}/`} aria-current={on(path === `/projects/${activeProject.slug}/`)}>Overview</a>
        {activeProject.demo && <a href={activeProject.demo.href}>Demo</a>}
        <a href={`/projects/${activeProject.slug}/prd/`}>Product</a>
        {activeProject.hasReport !== false && <a href={`/projects/${activeProject.slug}/report/`}>Evidence</a>}
        <a href={`/projects/${activeProject.slug}/launch-decision-memo/`}>Decision</a>
        <a href={`/projects/${activeProject.slug}/#fixes`}>Fix plan</a>
        <a href={`/projects/${activeProject.slug}/#artifacts`}>Artifacts</a>
      </div>
    </nav>
  )}

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="site">
    <div class="inner">
      <p>Every number on this site is read at build time from a committed run artifact. None of them is typed by hand. If a figure cannot be sourced, it does not appear.</p>
    </div>
  </footer>

  <script is:inline>
    /* One observer for the whole site. Paper lands when it comes into view. */
    (function () {
      if (document.documentElement.dataset.motion !== "on") return;
      var targets = document.querySelectorAll(".cut, .drawn-rule, [data-poster]");
      if (!("IntersectionObserver" in window)) {
        targets.forEach(function (el) { el.classList.add("in"); });
        return;
      }
      /* Arm each element only now: before this line it is plain visible text. */
      targets.forEach(function (el) { el.setAttribute("data-armed", ""); });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("in");
          io.unobserve(entry.target);
        });
      }, { rootMargin: "0px 0px -12% 0px", threshold: 0.15 });
      targets.forEach(function (el) { io.observe(el); });
    })();
  </script>
</body>
</html>
