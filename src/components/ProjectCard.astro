---
/* A project, at page scale, drenched in its own ink. Affirmative only: what it
   is, and one measured figure of what it covers. What the evaluation decided
   lives one click in, on the project page, where the tables are. */
import type { Project } from "../lib/site";
interface Props { project: Project; index: number }
const { project: p, index } = Astro.props;
---
<a class="field-card band" data-field={p.ink} href={`/projects/${p.slug}/`}>
  <div class="split">
    <div class="say">
      <p class="label">{p.domain}</p>
      <h3 class="display display-l">{p.name}</h3>
      <p class="blurb">{p.blurb}</p>
      <span class="go">View case study</span>
    </div>
    <div class="count">
      <span class="figure cut cut-r">{p.scale.value}</span>
      <p class="scale-label cut cut-r" style="--d:120ms">{p.scale.label}</p>
    </div>
  </div>
  <span class="edge" aria-hidden="true"></span>
</a>

<style>
  .field-card{display:block;text-decoration:none;position:relative;overflow:hidden}
  .field-card .split > *{padding-block:clamp(2.5rem,6vw,4.25rem)}
  .say{display:flex;flex-direction:column;gap:.75rem;align-items:start}
  .say .label{margin-bottom:.15rem}
  .say h3{max-width:14ch}
  .blurb{margin:0;max-width:34ch;font-size:1.02rem;line-height:1.5}
  .go{
    margin-top:.6rem;font-family:var(--mono);font-size:.72rem;
    letter-spacing:.1em;text-transform:uppercase;
    border-bottom:2px solid currentColor;padding-bottom:.2rem;
  }
  .count{display:flex;flex-direction:column;justify-content:center;align-items:start}
  .scale-label{margin:.7rem 0 0;max-width:26ch;font-size:.92rem;line-height:1.45}

  /* A blade of the page's ground slides across as the card is taken up. */
  .edge{
    position:absolute;inset:0 auto 0 0;width:100%;
    background:var(--paper);transform:scaleX(0);transform-origin:right;
    transition:transform var(--t2) var(--cut);
    pointer-events:none;mix-blend-mode:overlay;opacity:.14;
  }
  .field-card:hover .edge,.field-card:focus-visible .edge{transform:scaleX(1);transform-origin:left}
  .field-card:hover .go{border-bottom-width:4px}
  .field-card:focus-visible{outline:4px solid var(--paper);outline-offset:-8px}
  [data-field="chrome"].field-card:focus-visible{outline-color:var(--ink)}

  @media (max-width:820px){
    .count{padding-top:0}
    .say{gap:.6rem}
  }
  @media (prefers-reduced-motion:reduce){ .edge{display:none} }
</style>
