---
/* A project's evaluation signature, compressed to a glyph. Same measurement
   apparatus as the full poster on the project page, same committed data behind
   it, small enough to sit in the hero contact sheet. Nothing here is a logo.
   Drawn in currentColor so a mark inverts with the tile it sits in. */
import type { Mark } from "../lib/site";
interface Props { mark: Mark }
const { mark } = Astro.props;

const W = 132, H = 92;

/* The gate: a rule that does not move, and every configuration stopping short. */
const gate = (m: Extract<Mark, { kind: "gate" }>) => {
  const x = (v: number) => 10 + ((Math.min(Math.max(v, m.lo), 1) - m.lo) / (1 - m.lo)) * (W - 30);
  const gx = x(m.gate);
  const rows = m.values.map((v, i) => ({ y: 18 + i * 10, x2: x(v) }));
  return { gx, rows };
};

/* Repeated passes of the same run. The detailed case study carries the verdict. */
const VC = { r: 23, d: 12, cx: W / 2, cy: H / 2 - 6 };
const lobes = [
  [VC.cx, VC.cy - VC.d],
  [VC.cx + VC.d * 0.866, VC.cy + VC.d * 0.5],
  [VC.cx - VC.d * 0.866, VC.cy + VC.d * 0.5],
];

/* The fixtures, and the ones that went through. */
const punchCells = (m: Extract<Mark, { kind: "punch" }>) => {
  const cols = 8, rows = Math.ceil(m.total / cols), c = 13, g = 2.6;
  const ox = (W - (cols * c + (cols - 1) * g)) / 2;
  const oy = (H - (rows * c + (rows - 1) * g)) / 2;
  const cutAt = new Set(Array.from({ length: m.cut }, (_, i) => Math.floor((i * m.total) / m.cut)));
  return Array.from({ length: m.total }, (_, i) => ({
    x: ox + (i % cols) * (c + g),
    y: oy + Math.floor(i / cols) * (c + g),
    s: c,
    cut: cutAt.has(i),
  }));
};

/* How much a yes-or-no check can tell you. Zero at both ends. */
const Hb = (p: number) => (p <= 0 || p >= 1 ? 0 : -(p * Math.log2(p) + (1 - p) * Math.log2(1 - p)));
const hill = (m: Extract<Mark, { kind: "hill" }>) => {
  const x = (p: number) => 12 + p * (W - 24);
  const y = (h: number) => H - 20 - h * (H - 42);
  const path = Array.from({ length: 61 }, (_, i) => {
    const p = i / 60;
    return `${i ? "L" : "M"}${x(p).toFixed(1)},${y(Hb(p)).toFixed(1)}`;
  }).join(" ");
  return { path, marks: m.points.map((p) => ({ x: x(p), y: y(Hb(p)) })), base: y(0) };
};

const g = mark.kind === "gate" ? gate(mark) : null;
const cells = mark.kind === "punch" ? punchCells(mark) : null;
const hl = mark.kind === "hill" ? hill(mark) : null;
const recall = mark.kind === "recall"
  ? (() => {
      const s = 16, gap = 7;
      const width = mark.values.length * s + (mark.values.length - 1) * gap;
      const ox = (W - width) / 2;
      return mark.values.map((hit, i) => ({ x: ox + i * (s + gap), hit }));
    })()
  : null;
---
<svg class="mark-svg" data-kind={mark.kind} viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
  {g && (
    <g>
      {g.rows.map((r) => (
        <line class="m-bar" x1="10" y1={r.y} x2={r.x2} y2={r.y} stroke="currentColor" stroke-width="5" opacity=".55" />
      ))}
      <line class="m-gate" x1={g.gx} y1="8" x2={g.gx} y2={H - 8} stroke="currentColor" stroke-width="3.5" />
    </g>
  )}

  {mark.kind === "venn" && (
    <g>
      {lobes.slice(0, mark.passes).map(([cx, cy]) => (
        <circle cx={cx} cy={cy} r={VC.r} fill="none" stroke="currentColor" stroke-width="2.4" opacity=".85" />
      ))}
      <text class="m-num" x={VC.cx} y={VC.cy + 6} text-anchor="middle" fill="currentColor">{mark.passes}</text>
    </g>
  )}

  {cells && cells.map((c) => (
    <rect x={c.x} y={c.y} width={c.s} height={c.s}
          fill={c.cut ? "none" : "currentColor"}
          stroke="currentColor" stroke-width={c.cut ? 1.4 : 0}
          opacity={c.cut ? 1 : .82} />
  ))}

  {hl && (
    <g>
      <line x1="12" y1={hl.base} x2={W - 12} y2={hl.base} stroke="currentColor" stroke-width="1.4" opacity=".45" />
      <path d={hl.path} fill="none" stroke="currentColor" stroke-width="2.2" opacity=".55" />
      {hl.marks.map((p) => <rect x={p.x - 3} y={p.y - 3} width="6" height="6" fill="currentColor" />)}
    </g>
  )}

  {recall && (
    <g>
      <line x1="10" y1={H / 2} x2={W - 10} y2={H / 2} stroke="currentColor" stroke-width="1.4" opacity=".42" />
      {recall.map((cell) => (
        <rect
          x={cell.x}
          y={(H - 16) / 2}
          width="16"
          height="16"
          fill={cell.hit ? "currentColor" : "none"}
          stroke="currentColor"
          stroke-width="2.2"
        />
      ))}
    </g>
  )}
</svg>

<style>
  .mark-svg{display:block;width:100%;height:auto}
  .m-num{font-family:var(--mono);font-size:22px;font-weight:600;letter-spacing:-.04em}
</style>
