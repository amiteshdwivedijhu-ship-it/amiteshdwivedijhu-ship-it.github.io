---
/* Renders any <pre class="mermaid"> blocks (lifted from ```mermaid fences at sync
   time) into inline SVG, themed to the house palette: ink on paper, square corners. If a diagram fails to parse,
   the source block stays visible as plain text. */
---
<script>
  import mermaid from "mermaid";

  mermaid.initialize({
    startOnLoad: false,
    securityLevel: "antiscript",
    theme: "base",
    /* Render at natural size and let the container scroll. Fitting a seven-node
       flow into the text measure shrinks it below reading size and clips labels. */
    flowchart: { useMaxWidth: false, htmlLabels: true, nodeSpacing: 34, rankSpacing: 44, padding: 10 },
    sequence: { useMaxWidth: false },
    gantt: { useMaxWidth: false },
    themeVariables: {
      background: "#f2efe3",
      primaryColor: "#e8e4d4",
      primaryBorderColor: "#171613",
      primaryTextColor: "#171613",
      secondaryColor: "#dbd6c3",
      tertiaryColor: "#f2efe3",
      lineColor: "#5a574c",
      textColor: "#171613",
      mainBkg: "#e8e4d4",
      nodeBorder: "#171613",
      clusterBkg: "#f2efe3",
      clusterBorder: "#d5d0be",
      edgeLabelBackground: "#f2efe3",
      titleColor: "#171613",
      fontFamily: '"Archivo Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif',
      fontSize: "16px",
    },
  });

  /* Mermaid measures label widths itself. Render only once Archivo has actually
     loaded, or it sizes every node against fallback metrics and clips the text. */
  await document.fonts.ready;

  document.querySelectorAll("pre.mermaid").forEach(async (el, i) => {
    try {
      const { svg } = await mermaid.render(`mmd-${i}`, el.textContent ?? "");
      const div = document.createElement("div");
      div.className = "mermaid-diagram";
      div.innerHTML = svg;
      el.replaceWith(div);
    } catch {
      /* leave the source visible */
    }
  });
</script>
