---
/* Met-precision by configuration, with Wilson 95% intervals. Every figure is read
   from the committed scorecards at build time. */
import summary from "../../data/prior-auth/_summary.json";
import ood from "../../data/prior-auth/ood.json";

const rows = Object.entries((summary as any).in_distribution).map(([cfg, m]: [string, any]) => ({
  label: cfg,
  value: m.met_precision.value as number,
  ci: m.met_precision.wilson95 as number[],
  n: m.met_precision.n as number,
}));
const g = (ood as any).slices.ood.gates.met_precision;
rows.push({ label: "ood-fc-golden", value: g.value, ci: g.wilson95, n: g.n });

const LO = 0.8, HI = 1.0, BAR = 0.95;
const X0 = 178, X1 = 596, W = 672;
const x = (v: number) => X0 + ((Math.min(Math.max(v, LO), HI) - LO) / (HI - LO)) * (X1 - X0);
const rh = 34, top = 22, axisH = 26;
const H = top + rows.length * rh + axisH;
const ticks = [0.8, 0.9, 1.0];
---
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Met-precision by configuration, with Wilson 95 percent confidence intervals, against the 0.95 bar">
  {ticks.map((tv) => (
    <line x1={x(tv)} y1={top - 6} x2={x(tv)} y2={top + rows.length * rh} stroke="rgba(255,255,255,.07)" stroke-width="1" />
  ))}
  <line x1={x(BAR)} y1={top - 10} x2={x(BAR)} y2={top + rows.length * rh} stroke="var(--accent)" stroke-width="1.4" stroke-dasharray="5 4" />
  <text x={x(BAR)} y={top - 14} text-anchor="middle" class="flbl" fill="var(--accent)">bar 0.95</text>
  {rows.map((r, i) => {
    const y = top + i * rh + rh / 2;
    return (
      <g>
        <text x={0} y={y + 4} class="flbl" fill="var(--muted)">{r.label}</text>
        <line x1={x(r.ci[0])} y1={y} x2={x(r.ci[1])} y2={y} stroke="var(--accent)" stroke-width="2" stroke-linecap="round" opacity=".65" />
        <line x1={x(r.ci[0])} y1={y - 4} x2={x(r.ci[0])} y2={y + 4} stroke="var(--accent)" stroke-width="2" opacity=".65" />
        <line x1={x(r.ci[1])} y1={y - 4} x2={x(r.ci[1])} y2={y + 4} stroke="var(--accent)" stroke-width="2" opacity=".65" />
        <circle cx={x(r.value)} cy={y} r="4.5" fill="var(--ink)" />
        <text x={X1 + 8} y={y + 4} class="flbl" fill="var(--dim)">{r.value.toFixed(3)}</text>
      </g>
    );
  })}
  {ticks.map((tv) => (
    <text x={x(tv)} y={H - 6} text-anchor="middle" class="flbl" fill="var(--dim)">{tv.toFixed(2)}</text>
  ))}
</svg>
<style>
  svg{width:100%;height:auto;display:block}
  .flbl{font-family:var(--mono);font-size:10.5px;letter-spacing:.02em}
</style>
