---
/* Five known false-confidence cases entered the grader with the same expected
   diagnosis. Each row shows where the recorded run actually sent the learner.
   The paths are data, not decoration: one held and four diverged. */
import { LEARNING } from "../../lib/site";

const human = (value: string) => value.replaceAll("_", " ");
---
<figure class="grader-paths" aria-labelledby="grader-paths-title">
  <figcaption id="grader-paths-title" class="sr-only">
    The recorded grader caught one of five right-answer-wrong-reason cases and routed the other four to different diagnoses.
  </figcaption>

  <div class="route-head" aria-hidden="true">
    <span>Known diagnosis</span>
    <span>Recorded diagnosis</span>
  </div>

  <ol class="routes">
    {LEARNING.target.map((result, index) => (
      <li class:list={{ held: result.pass, missed: !result.pass }}>
        <span class="fixture num">{String(index + 1).padStart(2, "0")}</span>
        <span class="expected">right answer, wrong reason</span>
        <span class="path" aria-hidden="true"><i></i></span>
        <span class="actual">{human(result.actual)}</span>
        <span class="call">{result.pass ? "caught" : "misrouted"}</span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .sr-only{
    position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
    clip:rect(0,0,0,0);white-space:nowrap;border:0;
  }
  .grader-paths{margin:0;border:1px solid var(--ink);background:var(--paper)}
  .route-head{
    display:grid;grid-template-columns:2.2rem minmax(12rem,1fr) minmax(5rem,.65fr) minmax(12rem,1fr) auto;
    gap:1rem;padding:.7rem 1rem;border-bottom:2px solid var(--ink);
    font-family:var(--mono);font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);
  }
  .route-head span:first-child{grid-column:2}
  .route-head span:last-child{grid-column:4}
  .routes{margin:0;padding:0;list-style:none}
  .routes li{
    display:grid;grid-template-columns:2.2rem minmax(12rem,1fr) minmax(5rem,.65fr) minmax(12rem,1fr) auto;
    gap:1rem;align-items:center;min-height:4.6rem;padding:.7rem 1rem;border-bottom:1px solid var(--paper-edge);
  }
  .routes li:last-child{border-bottom:0}
  .fixture{font-size:.72rem;color:var(--ink-soft)}
  .expected,.actual{font-variation-settings:"wdth" 104,"wght" 690;text-transform:capitalize;line-height:1.25}
  .path{display:block;height:2px;background:var(--paper-edge);position:relative}
  .path::before,.path::after{
    content:"";position:absolute;top:50%;width:8px;height:8px;background:var(--paper);
    border:2px solid currentColor;transform:translateY(-50%);
  }
  .path::before{left:0}.path::after{right:0}
  .path i{display:block;height:2px;background:currentColor;transform-origin:left}
  .held{color:var(--viridian-deep)}
  .missed{color:var(--vermilion-deep)}
  .call{
    font-family:var(--mono);font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;
    border:1px solid currentColor;padding:.25rem .45rem;white-space:nowrap;
  }

  @media (max-width:720px){
    .route-head{display:none}
    .routes li{
      grid-template-columns:2rem 1fr auto;gap:.35rem .7rem;
      align-items:start;padding:.85rem .9rem;
    }
    .fixture{grid-row:1/4;padding-top:.15rem}
    .expected{grid-column:2}
    .expected::before{
      content:"Expected  ";display:block;font-family:var(--mono);font-size:.6rem;
      letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:.12rem;
    }
    .path{grid-column:2;height:1.25rem;width:2px;margin-left:.35rem;background:currentColor}
    .path::before,.path::after{width:7px;height:7px;left:50%;right:auto;transform:translate(-50%,-50%)}
    .path::after{top:auto;bottom:0;transform:translate(-50%,50%)}
    .path i{display:none}
    .actual{grid-column:2}
    .actual::before{
      content:"Returned  ";display:block;font-family:var(--mono);font-size:.6rem;
      letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:.12rem;
    }
    .call{grid-column:3;grid-row:1/4;align-self:center}
  }
</style>
