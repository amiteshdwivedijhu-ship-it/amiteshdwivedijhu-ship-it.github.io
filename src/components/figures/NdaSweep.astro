---
/* POSTER — "The seven that went through."
   One cell per splice fixture: a real NDA body with an unacceptable clause of
   known type planted in it, so ground truth holds by construction. A filled
   cell is a clause the system found. A cut cell is one it did not, and a
   missed unacceptable clause is the failure the kill criterion exists to catch.
   The product this measures is absence detection, so the holes are the subject.
   Read at build time from the committed phase-F report. */
import report from "../../data/nda-triage/report.json";

const ex = (report as any).extraction;
const TOTAL: number = ex.spliced_fixtures;
const misses: any[] = ex.kill_criterion_misses;
const MISSED = misses.length;

/* Cell position carries no meaning: these fixtures are a set, not a sequence.
   The cut cells are spread evenly so the sheet reads as a proportion. */
const cutAt = new Map<number, any>(
  misses.map((m, i) => [Math.floor((i * TOTAL) / MISSED), m])
);

const COLS = 8;
const ROWS = Math.ceil(TOTAL / COLS);
const CELL = 62, GAP = 9, PAD = 4;
const W = PAD * 2 + COLS * CELL + (COLS - 1) * GAP;
const H = PAD * 2 + ROWS * CELL + (ROWS - 1) * GAP;

const cells = Array.from({ length: TOTAL }, (_, i) => ({
  i,
  x: PAD + (i % COLS) * (CELL + GAP),
  y: PAD + Math.floor(i / COLS) * (CELL + GAP),
  miss: cutAt.get(i) ?? null,
}));
const label = (m: any) => `${m.fixture_id}, ${m.cuad_category}: planted and not reported`;
---
<figure class="punch">
  <svg class="poster sheet" viewBox={`0 0 ${W} ${H}`} data-poster
       role="img"
       aria-label={`${TOTAL} splice fixtures, each carrying a planted unacceptable clause. ${TOTAL - MISSED} were caught. ${MISSED} were not.`}>
    {cells.map((c) => (
      c.miss ? (
        <g class="cell cut" style={`--d:${90 + c.i * 34}ms`}>
          <title>{label(c.miss)}</title>
          <rect x={c.x} y={c.y} width={CELL} height={CELL}
                fill="var(--paper)" stroke="var(--cobalt-deep)" stroke-width="1.5" />
        </g>
      ) : (
        <rect class="cell hit" x={c.x} y={c.y} width={CELL} height={CELL}
              fill="var(--cobalt)" style={`--d:${90 + c.i * 34}ms`} />
      )
    ))}
  </svg>
  <figcaption>
    <p class="punch-read">
      <span class="num punch-fig">{MISSED}</span>
      <span>of {TOTAL} planted unacceptable clauses were not reported. The kill criterion
      was written before the runs and it is a false-negative statement, so one is enough.</span>
    </p>
    <p class="punch-key">
      <span><i class="filled"></i>caught</span>
      <span><i class="cutk"></i>went through</span>
    </p>
  </figcaption>
</figure>

<style>
  .punch{margin:0}
  .sheet{max-width:34rem}
  .punch figcaption{max-width:40rem}
  .punch-read{
    display:flex;gap:.9rem;align-items:flex-start;
    margin:1.1rem 0 .6rem;font-size:.95rem;line-height:1.5;color:var(--ink-soft);
  }
  .punch-fig{
    font-size:clamp(2.2rem,6vw,3.2rem);line-height:.85;color:var(--cobalt-deep);
    font-variation-settings:"wght" 700;letter-spacing:-.04em;flex:0 0 auto;margin-top:-.12em;
  }
  .punch-key{display:flex;gap:1.3rem;margin:0;font-size:.78rem;color:var(--ink-soft)}
  .punch-key span{display:inline-flex;align-items:center;gap:.45rem}
  .punch-key i{width:.85rem;height:.85rem;display:inline-block}
  .punch-key i.filled{background:var(--cobalt)}
  .punch-key i.cutk{background:var(--paper);border:1.5px solid var(--cobalt-deep)}

  /* The sheet fills in, cell by cell, and seven slots never fill. */
  :global([data-motion="on"]) .sheet .hit{opacity:0}
  :global([data-motion="on"]) .sheet.in .hit{animation:cell-lay 300ms var(--cut) both;animation-delay:var(--d)}
  @keyframes cell-lay{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
  @media (prefers-reduced-motion:reduce){
    :global([data-motion="on"]) .sheet .hit{opacity:1;transform:none}
  }
</style>
