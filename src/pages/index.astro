---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Icon from "../components/Icon.astro";
import { getCollection } from "astro:content";
import { PROJECTS } from "../lib/site";
const count = PROJECTS.length;

/* Counted, not claimed: what is actually published on this site. */
const artifacts = await getCollection("artifacts");
const reports = await getCollection("reports");
const demos = PROJECTS.filter((p) => p.demo).length;
const inventory = [
  { n: count, label: "case studies" },
  { n: artifacts.length + reports.length, label: "documents, all published" },
  { n: demos, label: "prototypes you can open" },
];
const spelled = ["", "One", "Two", "Three", "Four", "Five", "Six"][count] ?? String(count);

/* How the work actually goes, in the site's own icon grammar. */
const method = [
  { icon: "rubric", name: "Start at the decision", detail: "Whose call is it, and what would change it." },
  { icon: "funnel", name: "Build the smallest useful thing", detail: "One workflow end to end, not a demo of a feature." },
  { icon: "gate", name: "Set the bar before the run", detail: "Written down first, so it cannot move afterwards." },
  { icon: "table", name: "Publish what it said", detail: "Including the runs that decided against the product." },
];
---
<Base title="Amitesh Dwivedi">
  <section class="band hero" aria-labelledby="hero-line">
    <div class="inner">
      <p class="hello cut">Hi, I'm Amitesh.</p>
      <h1 id="hero-line" class="display display-xl cut" style="--d:80ms">
        I build AI<br />products<span class="stop" aria-hidden="true"></span>
      </h1>
      <div class="gate" aria-hidden="true"><span class="drawn-rule"></span></div>

      <div class="hero-body">
        <div class="hero-say">
          <div class="hero-copy">
            <p class="hero-note cut" style="--d:220ms">
              I turn high-stakes workflows into working AI products, with the
              evaluation systems teams need to improve them and deploy responsibly.
            </p>
            <nav class="hero-do cut" style="--d:300ms" aria-label="Start here">
              <a class="pill solid" href="#work">See the work</a>
            </nav>
          </div>

          <dl class="inventory cut" style="--d:380ms">
            {inventory.map((item) => (
              <div>
                <dt class="num">{item.n}</dt>
                <dd>{item.label}</dd>
              </div>
            ))}
          </dl>
        </div>

      </div>
    </div>
  </section>

  <section class="band tight" id="work" aria-labelledby="work-title">
    <div class="inner">
      <h2 id="work-title" class="display display-m cut">
        {spelled} products, from workflow design to working evidence.
      </h2>
    </div>
  </section>

  {PROJECTS.map((project, index) => <ProjectCard project={project} index={index} />)}

  <section class="band" aria-labelledby="method-title">
    <div class="inner">
      <h2 id="method-title" class="display display-s cut">How I work</h2>
      <ol class="method">
        {method.map((m, i) => (
          <li class="cut" style={`--d:${i * 80}ms`}>
            <Icon name={m.icon} />
            <strong>{m.name}</strong>
            <small>{m.detail}</small>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band" aria-label="Background">
    <div class="split">
      <div>
        <h2 class="display display-s cut">At Ellipsis Health</h2>
        <p class="cut" style="--d:80ms">
          I took a clinical voice care-management platform from zero to production
          across 10+ enterprise healthcare accounts, including Aetna, Duke and
          Highmark, and founded the agent evaluation function: the check every
          clinical agent passes before it launches.
        </p>
      </div>
      <div>
        <h2 class="display display-s cut" style="--d:60ms">What I am after</h2>
        <p class="cut" style="--d:140ms">
          Product roles where the hard part is judging whether an AI system is good
          enough to put in front of someone, and where being right about that
          matters more than shipping quickly.
        </p>
      </div>
    </div>
  </section>

  <section class="band close" aria-labelledby="close-title">
    <div class="inner">
      <h2 id="close-title" class="display display-m">
        The evidence is the point.
      </h2>
      <p class="measure" style="margin:1rem 0 0">
        Every figure on this site is read at build time from a committed run
        artifact. Nothing is typed by hand, and a number that cannot be sourced
        does not appear.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero .inner{padding-top:clamp(2.5rem,7vw,5rem);padding-bottom:clamp(2.5rem,5vw,4rem)}
  .hello{
    font-family:var(--mono);font-size:.82rem;letter-spacing:.14em;
    text-transform:uppercase;color:var(--ink-soft);margin:0 0 1.1rem;
  }
  .hero h1{max-width:13ch}
  /* The full stop is cut, not typed: the site's one mark, and the shape a
     decision leaves behind. */
  .stop{
    display:inline-block;width:.2em;height:.2em;background:var(--vermilion);
    margin-left:.08em;vertical-align:baseline;
  }
  /* The bar the work is held to. It draws once, then it is simply there. */
  .gate{margin:clamp(1.4rem,3.5vw,2.2rem) 0 1.6rem}
  .gate span{display:block;height:4px;background:var(--ink);transform-origin:left}

  .hero-body{
    display:grid;gap:clamp(2rem,4vw,3.25rem);
  }
  .hero-say{
    display:grid;grid-template-columns:minmax(18rem,1fr) minmax(24rem,.9fr);
    gap:clamp(2rem,7vw,6rem);align-items:end;
  }
  .hero-copy{display:flex;flex-direction:column;gap:1.5rem;max-width:36rem}
  .hero-note{margin:0;font-size:1.06rem;line-height:1.55;color:var(--ink-soft)}
  .hero-do{display:flex;flex-wrap:wrap;gap:.6rem}
  .inventory{
    display:grid;grid-template-columns:repeat(3,auto);gap:0 clamp(1.2rem,3vw,2.4rem);
    justify-content:start;margin:.4rem 0 0;padding-top:1.4rem;
    border-top:1px solid var(--rule);
  }
  .inventory div{display:flex;flex-direction:column;gap:.15rem}
  .inventory dt{
    font-size:clamp(1.5rem,3vw,2rem);font-variation-settings:"wght" 600;
    letter-spacing:-.04em;line-height:1;
  }
  .inventory dd{margin:0;font-size:.8rem;line-height:1.35;color:var(--ink-soft);max-width:11ch}

  /* How I work, as four steps rather than a paragraph. */
  .method{
    display:grid;grid-template-columns:repeat(4,1fr);gap:1px;
    background:var(--rule);border:1px solid var(--rule);
    margin:1.6rem 0 0;padding:0;list-style:none;
  }
  .method li{
    background:var(--paper);display:flex;flex-direction:column;gap:.5rem;
    padding:1.1rem 1.1rem 1.2rem;
  }
  .method :global(.ico){color:var(--ink)}
  .method strong{font-variation-settings:"wdth" 104,"wght" 750;font-size:.95rem;line-height:1.2}
  .method small{color:var(--ink-soft);font-size:.84rem;line-height:1.45}

  .close .inner{padding-block:clamp(2.75rem,6vw,4.25rem)}

  @media (max-width:1000px){
    .hero-say{grid-template-columns:1fr;gap:1.75rem;align-items:start}
    .hero-copy{max-width:38rem}
    .method{grid-template-columns:repeat(2,1fr)}
  }
  @media (max-width:520px){
    .hero .inner{padding-top:2rem}
    .inventory{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
    .method{grid-template-columns:1fr}
    .method li{padding:.95rem 1rem}
  }
</style>
