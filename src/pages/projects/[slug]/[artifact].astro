---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Mermaid from "../../../components/Mermaid.astro";
import { bySlug } from "../../../lib/site";

export async function getStaticPaths() {
  const all = await getCollection("artifacts");
  return all.map((a) => ({
    params: { slug: a.data.project, artifact: a.id.split("/").pop() },
    props: { entry: a },
  }));
}
const { entry } = Astro.props;
const p = bySlug(entry.data.project);
const { Content } = await render(entry);
const artifacts = (await getCollection("artifacts", (a) => a.data.project === p.slug))
  .sort((a, b) => a.data.order - b.data.order);
const index = artifacts.findIndex((a) => a.id === entry.id);
const previous = index > 0 ? artifacts[index - 1] : undefined;
const next = index < artifacts.length - 1 ? artifacts[index + 1] : undefined;
const minutes = Math.max(3, Math.ceil(entry.body.trim().split(/\s+/).length / 220));
const updated = entry.body.match(/Last updated:\*\*\s*([^\n]+)/i)?.[1]?.trim() ?? "Aug 22, 2026";
const hrefFor = (a: typeof entry) => `/projects/${p.slug}/${a.id.split("/").pop()}/`;
---
<Base title={`${entry.data.title} – ${p.name}`} description={entry.data.hook}>
  <div class="progress" aria-hidden="true"><span></span></div>

  <header class="band head" data-field={p.ink}>
    <div class="inner">
      <p class="label">
        {p.name} · document {String(index + 1).padStart(2, "0")} of {String(artifacts.length).padStart(2, "0")} · {minutes} min · updated {updated}
      </p>
      <h1 class="display display-l cut">{entry.data.title}</h1>
      <p class="takeaway cut measure" style="--d:100ms">{entry.data.hook}</p>
    </div>
  </header>

  <div class="band">
    <div class="inner reading">
      <article class="prose"><Content /></article>
      <p class="source num">Source: {entry.data.source}</p>
      <Mermaid />
    </div>
  </div>

  <nav class="band tight steps" aria-label="Document sequence">
    <div class="inner">
      <div class="step-grid">
        {previous ? (
          <a class="step" href={hrefFor(previous)}>
            <span class="num">Previous</span>
            <strong>{previous.data.title}</strong>
          </a>
        ) : <span class="step empty" aria-hidden="true"></span>}
        {next ? (
          <a class="step next" href={hrefFor(next)}>
            <span class="num">Next</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : p.hasReport !== false ? (
          <a class="step next" href={`/projects/${p.slug}/report/`}>
            <span class="num">Next</span>
            <strong>Eval report</strong>
          </a>
        ) : (
          <a class="step next" href={`/projects/${p.slug}/`}>
            <span class="num">Return</span>
            <strong>Case study</strong>
          </a>
        )}
      </div>
      <details class="all">
        <summary>All {artifacts.length} documents, in the order worth reading them</summary>
        <ol>
          {artifacts.map((a) => (
            <li>
              <a href={hrefFor(a)} aria-current={a.id === entry.id ? "page" : undefined}>{a.data.title}</a>
              <small>{a.data.hook}</small>
            </li>
          ))}
        </ol>
      </details>
    </div>
  </nav>
</Base>

<style>
  .progress{position:fixed;left:0;right:0;top:0;height:3px;z-index:40;background:transparent}
  .progress span{display:block;height:100%;width:0;background:var(--vermilion)}
  .head .label{margin-bottom:.9rem}
  .takeaway{
    margin:1.4rem 0 0;font-size:clamp(1.1rem,2vw,1.32rem);line-height:1.45;
    padding-left:1.1rem;border-left:1px solid currentColor;
  }
  .reading{max-width:var(--wrap)}
  .source{color:var(--ink-soft);font-size:.74rem;margin-top:3.5rem;letter-spacing:.06em}

  .step-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--rule);border:1px solid var(--rule)}
  .step{
    background:var(--paper);display:flex;flex-direction:column;gap:.3rem;
    padding:1.1rem 1.2rem;text-decoration:none;min-height:5.5rem;
    transition:background var(--t1) var(--cut),color var(--t1) var(--cut);
  }
  .step .num{font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft)}
  .step strong{font-variation-settings:"wdth" 104,"wght" 750;font-size:1rem;line-height:1.25}
  .step.next{text-align:right;align-items:flex-end}
  .step:hover{background:var(--ink);color:var(--paper)}
  .step:hover .num{color:inherit;opacity:.8}
  .step.empty{background:var(--paper)}

  .all{margin-top:1.5rem;border:1px solid var(--rule);background:var(--paper-sunk)}
  .all summary{
    cursor:pointer;min-height:44px;display:flex;align-items:center;padding:.6rem 1.1rem;
    font-family:var(--mono);font-size:.74rem;letter-spacing:.08em;text-transform:uppercase;
  }
  .all ol{margin:0;padding:0 1.1rem 1.1rem 2.4rem}
  .all li{padding:.4rem 0}
  .all li a{font-variation-settings:"wght" 600}
  .all li a[aria-current="page"]{text-decoration-color:var(--vermilion);text-decoration-thickness:3px}
  .all small{display:block;color:var(--ink-soft);line-height:1.45;font-size:.85rem}

  @media (max-width:640px){
    .step-grid{grid-template-columns:1fr}
    .step.next{text-align:left;align-items:flex-start}
    .step.empty{display:none}
  }
</style>

<script is:inline>
  (function () {
    var bar = document.querySelector(".progress span");
    if (!bar) return;
    var tick = function () {
      var max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = (max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0) + "%";
    };
    addEventListener("scroll", tick, { passive: true });
    addEventListener("resize", tick);
    tick();
  })();
</script>
