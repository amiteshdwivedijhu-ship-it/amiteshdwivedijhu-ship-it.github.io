---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import ResultsTable from "../../../components/ResultsTable.astro";
import PaGates from "../../../components/figures/PaGates.astro";
import StabilityDots from "../../../components/figures/StabilityDots.astro";
import NdaSweep from "../../../components/figures/NdaSweep.astro";
import CoverageBand from "../../../components/figures/CoverageBand.astro";
import GraderPaths from "../../../components/figures/GraderPaths.astro";
import Pipeline from "../../../components/Pipeline.astro";
import { PROJECTS, TABLES, PIPELINES, bySlug } from "../../../lib/site";
/* The fix plan per project, taken in order from each launch-decision memo's
   "what would change the decision" section. First step is always the cheapest
   discriminating experiment. Loaded with the verdict: same field, same run. */
const FIXES: Record<string, string[]> = {
  "prior-auth": [
    "Stop the cheap checker rejecting on its own authority: the first-pass model wrongly rejects 89.2% of the citations the recorded answer calls met, and the large model upholds 92.7% of what reaches it. Escalate everything the first pass doubts.",
    "Watch what that does to the precision gate. The large model is already the mechanism that could pull an unsupported assertion down to non-determinable, the same move the system already makes for a met with no locatable quote.",
    "Fix the over-commitment defect: non-binding policy language cannot license a met on its own. Two cases under Medicare's usually-three-months wording are the whole sample of the class, and both went wrong.",
    "Rebuild the corpus so it contains genuine ambiguity: 2 of 402 fictional answers are non-determinable, so whether the system declines well is unmeasured. Real notes decline 16.0% and are right 87.5% of those times.",
    "Fix what the policy reader gets wrong, not how much it misses. Counting near-matches lifts precision from 0.670 to 0.846; it almost always finds the right subject and gets the threshold, qualifier, or scope wrong, and on a prior auth criterion the threshold is the whole decision.",
    "Then get clinician labels or stop quoting accuracy numbers externally. Two labelers from one model family agree at 0.982; two physicians agree at 0.381. Agreement of 0.98 is more likely shared blind spots.",
  ],
  "10k-risk": [
    "Break both years into claims in one pass, so a section boundary is chosen once instead of independently for each year. The 189-to-194 claim wobble upstream is what propagates into false change downstream, and this removes the mechanism instead of compensating for it.",
    "Then, only if the drift survives, ship confidence instead of a yes or no: run three passes and surface what all three agree on. Real disclosures survive every pass; marginal judgment calls survive about one in three.",
    "Stop reporting tiny sets as percentages, and never sell the newly-disclosed flag as foresight until something links a flag to a later outcome. Sell it on analyst time saved, which the filings prove.",
  ],
  "nda-triage": [
    "Classify the splice misses first: every miss is a whole clause the reading stage never found, and the two unacceptable clause types are the entire launch decision. Sonnet 5 already catches 21 of 24.",
    "Add a dedicated second pass for those two clause types before touching any other model. It is cheaper than upgrading every document, and the gap between 21 and 24 is the decision.",
    "Make the search a required part of a valid answer rather than a suggestion: 6 of 10 hidden-evidence failures answered without ever going to look, and more search steps do not move that number.",
    "Rewrite the Shadow Judge's instructions with a severity threshold and suppression of what the Playbook already covers, or kill its veto entirely. A judge that is never silent makes every autonomy number meaningless.",
    "Only then score the untouched test set once, about $8.65 against the $28.17 left under the ceiling. Spending it now buys a post-mortem; spending it later buys a confirmation.",
  ],
  "calibration": [
    "Give the honesty items their own screen. On a consensus item both rationales argue the same verdict, so no keystroke says the ensemble is wrong, and four of the twelve minutes buy nothing. This is the blocker.",
    "Put a ceiling on the firing rate, symmetric with the floor. A check firing on 99% of conversations is as unmeasurable as one firing on 1%, and today the tool congratulates the first: three of five rewrites were mislabelled on this run alone.",
    "Derive the verdict sentence from the actual count, and add a check that runs the tool at a size other than the default. Both defects that survived all 61 checks survived because every check runs at the default.",
    "Fix format detection, and check the path a user actually takes: two of four formats fail through the one command, while every reader passes when called by name.",
    "Then measure the ninety seconds with one real product manager. The machine half works; the human half has never been run, and nothing above is worth doing if that number is three minutes instead of ninety seconds.",
  ],
  "learning-harness": [
    "Close the four open P1s before any learner runs: retries that duplicate a session, Ready labels on nodes that cannot case, revision mixing scopes, and a draft step that hangs past three minutes with no timeout.",
    "Record the pinned grader's calibration on the same 15 fixtures with a pre-registered recall bar. The recorded 0.20 is a budget-transport baseline and is labelled exactly that; the pinned grader has never been calibrated.",
    "Add the stability arm: three identical runs on the cheapest tier, pairwise agreement recorded. Two attempts have already flipped class or verdict between runs, and verdict instability is a grader-readiness metric on its own.",
    "Then take one real session. The live database holds zero sessions, and QA-017 is the only blocker between this code and that first datum.",
  ],
};

/* The two-minute walkthrough: five one-line stops per project, each sourced
   from the committed launch-decision memo. The skim layer; the full record
   stays one scroll below. */
const WALK: Record<string, { label: string; text: string; anchor: string }[]> = {
  "prior-auth": [
    { label: "The problem", text: "Prior authorization is a paperwork tax on care: staff hunt through charts to prove a patient meets criteria written by the payer.", anchor: "problem" },
    { label: "What I built", text: "A four-stage agent that reads the chart, checks the payer's published policy, and drafts the evidence-cited request every claim traces to.", anchor: "built" },
    { label: "The decision", text: "No ship: met-precision missed its pre-registered 0.95 bar on all six configurations, and the safety banner fired on 100 of 100 requests.", anchor: "finding" },
    { label: "The result", text: "Citation grounding held at 1.000 on every configuration, by construction: a claim with no locatable passage is downgraded.", anchor: "results" },
    { label: "The fix", text: "Stop the cheap checker rejecting on its own authority: 89.2% of its rejections are citations the recorded answer calls met.", anchor: "fixes" },
  ],
  "10k-risk": [
    { label: "The problem", text: "Item 1A runs 20 to 50 pages of litigation-drafted disclosure, and the two or three changes that matter are buried in recycled text.", anchor: "problem" },
    { label: "What I built", text: "Every risk factor is split into source-cited claims and compared with the prior year across 20 filings and 3,216 claims.", anchor: "built" },
    { label: "The decision", text: "No ship for alerting: identical runs agree between 0.10 and 0.92, and on Boeing none of the flagged passages survive all three.", anchor: "finding" },
    { label: "The result", text: "Zero invented quotations in 3,216 claims, by construction, and 98.2% of claims supported by the sentence they cite.", anchor: "results" },
    { label: "The fix", text: "Break both years into claims in one pass, then report only what all three passes agree on.", anchor: "fixes" },
  ],
  "nda-triage": [
    { label: "The problem", text: "The dangerous NDA is the one missing a standard protection, or carrying a quiet rider, in a queue of forty.", anchor: "problem" },
    { label: "What I built", text: "Reads each NDA, proves which expected clauses are absent, and routes by playbook, scored against ContractNLI's own expert annotations.", anchor: "built" },
    { label: "The decision", text: "Kill: no model tier cleared the unacceptable-clause criterion at these prices, so nothing ships at any autonomy setting.", anchor: "finding" },
    { label: "The result", text: "When it declares a clause absent it is right 98.3% of the time, and it finds 79.2% of the absences that are really there.", anchor: "results" },
    { label: "The fix", text: "Classify the misses, add a targeted second pass for the unacceptable clause types, then spend the held-out test set once.", anchor: "fixes" },
  ],
  "calibration": [
    { label: "The problem", text: "A product manager owns what good means for an AI agent, and the labelled dataset the standard answer requires is what her team cannot afford.", anchor: "problem" },
    { label: "What I built", text: "One command turns a prose rubric and a folder of conversations into a coverage table: which checks are measurable, with zero labels.", anchor: "built" },
    { label: "The decision", text: "Partial ship: the coverage table goes to one design partner, the arbitration queue does not, and the thirty-minute claim is dropped.", anchor: "finding" },
    { label: "The result", text: "Six checks triaged across 300 conversations with no human labels, and no accuracy number printed by design.", anchor: "results" },
    { label: "The fix", text: "The blocker: give the four hidden honesty items their own screen, so saying the ensemble is wrong becomes possible.", anchor: "fixes" },
  ],
  "learning-harness": [
    { label: "The problem", text: "Most learning tools grade answers, so a learner who reaches the right number by fragile reasoning leaves more confident and less able.", anchor: "problem" },
    { label: "What I built", text: "A local-first loop that maps principles and their boundaries, then cases the edge with free-prose answers graded by a closed taxonomy.", anchor: "built" },
    { label: "The decision", text: "No ship: the first recorded baseline caught 1 of 5 false-confidence fixtures, and four open P1s still let the served state lie.", anchor: "finding" },
    { label: "The result", text: "127 of 127 contract tests green, with zero learner sessions served: the record is honest because it is thin.", anchor: "results" },
    { label: "The fix", text: "Close the four P1s and calibrate the pinned grader against a pre-registered recall bar before one real session.", anchor: "fixes" },
  ],
};

export async function getStaticPaths() {
  return PROJECTS.map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
const p = bySlug(slug!);
const tables = TABLES[p.slug] ?? [];

const figures: Record<string, { caption: string; note: string }> = {
  "prior-auth": {
    caption:
      "Met-precision on every configuration, with its 95% confidence range. The heavy rule is the release bar, set before the run.",
    note: "Every configuration lands to the left of the rule, the out-of-distribution row included: a perfect point estimate on ten observations cannot lift the lower bound over 0.90.",
  },
  "10k-risk": {
    caption:
      "The same pipeline over the same filing, three times. Only the cache salt changes between passes, so every pass makes real calls rather than replaying the last one.",
    note: "Boeing agrees with itself on nothing: ten passages were flagged as newly disclosed risk and not one survives all three passes. Consolidated Edison, run identically, keeps seven of eight. The method is not rigged; the output on Boeing is not stable.",
  },
  "nda-triage": {
    caption:
      "Every cell is a splice fixture: a real NDA body with an unacceptable clause of known type planted inside it, so ground truth holds by construction.",
    note: "The holes are the product. This system exists to prove a clause is absent, and a planted clause it never reports is exactly the harm the kill criterion was written to catch.",
  },
  "calibration": {
    caption:
      "The height of the curve is the most a yes-or-no check can tell you at a given firing rate. It is arithmetic, not a threshold anyone chose: a check that fires on nothing and a check that fires on everything both carry the same amount, which is none.",
    note: "The tool had a floor on how rarely a check may fire and no ceiling at all. So three rewrites crossed the entire sheet, from one end where a check says nothing to the other end where it says nothing, and collected the strongest verdict the tool prints on the way.",
  },
  "learning-harness": {
    caption:
      "Five known false-confidence cases entered with the same expected diagnosis. Each route shows what the recorded grader returned instead.",
    note: "One route lands where it should. The other four change the lesson: a neighbouring rule, a mechanical slip, a missing foundation, or a sound verdict recorded after validation rejected the model's claim.",
  },
};
const fig = figures[p.slug];

const artifacts = (await getCollection("artifacts", (a) => a.data.project === p.slug))
  .sort((a, b) => a.data.order - b.data.order);
const readMinutes = (body: string) => Math.max(3, Math.ceil(body.trim().split(/\s+/).length / 220));
const hrefFor = (a: (typeof artifacts)[number]) => `/projects/${p.slug}/${a.id.split("/").pop()}/`;

const entries = [
  ...(p.demo ? [{ title: "Open the prototype", note: "Replays recorded runs in the browser. No keys, no server.", href: p.demo.href }] : []),
  ...(p.repo ? [{ title: p.repo.label, note: "Code, tests, calibration fixtures, and the complete project record.", href: p.repo.href }] : []),
  { title: "Read the product strategy", note: "The user, the workflow, the scope, and what was cut.", href: `/projects/${p.slug}/prd/` },
  p.hasReport === false
    ? { title: "Inspect the evidence", note: "The corpus, the protocol, and what each check was allowed to see.", href: p.report }
    : { title: "Inspect the eval report", note: "Every metric with its denominator and its uncertainty.", href: p.report },
  { title: "Read the decision", note: "How the evidence settled the recommendation.", href: `/projects/${p.slug}/launch-decision-memo/` },
];
---
<Base title={`${p.name} – Amitesh Dwivedi`} description={p.blurb}>
  <header class="band head" data-field={p.ink}>
    <div class="inner">
      <p class="label">{p.domain}</p>
      <h1 class="display display-l cut">{p.name}</h1>
      <p class="lede cut measure" style="--d:90ms;margin:1.1rem 0 0">{p.blurb}</p>
      <p class="head-scale cut" style="--d:170ms">
        <span class="num head-fig">{p.scale.value}</span>
        <span>{p.scale.label}</span>
      </p>
    </div>
  </header>

  <section class="band walk" data-ink={p.ink} aria-labelledby="walk-t">
    <div class="inner">
      <h2 id="walk-t" class="display display-s cut">Two-minute walkthrough</h2>
      <ul class="walk-list">
        {WALK[p.slug].map((stop, i) => (
          <li class="cut" style={`--d:${100 + i * 60}ms`}>
            <a class="walk-cell" href={`/projects/${p.slug}/#${stop.anchor}`}>
              <span class="walk-n num">{String(i + 1).padStart(2, "0")}</span>
              <span class="walk-label">{stop.label}</span>
              <p>{stop.text}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band tight" aria-label="Project brief">
    <div class="inner">
      <ul class="brief">
        {p.tldr.slice(0, 3).map((point) => <li set:html={point} />)}
      </ul>
    </div>
  </section>

  <nav class="band tight entries" aria-label="Ways into this project">
    <div class="inner">
      <div class="entry-grid">
        {entries.map((entry) => (
          <a class="entry" href={entry.href} target={entry.href.startsWith("https://") ? "_blank" : undefined} rel={entry.href.startsWith("https://") ? "noopener" : undefined}>
            <strong>{entry.title}</strong>
            <small>{entry.note}</small>
          </a>
        ))}
      </div>
    </div>
  </nav>

  {p.shot && (
    <section class="band tight" aria-label={`${p.name} interface`}>
      <div class="inner">
        <figure class="shot">
          <a class="shot-link" href={p.demo?.href ?? p.shot.src}>
            <img src={p.shot.src} alt={p.shot.alt} loading="lazy" decoding="async" width={p.shot.width} height={p.shot.height} />
          </a>
          <figcaption>{p.shot.caption} <a href={p.demo?.href ?? p.shot.src}>{p.demo ? "Open it" : "View full-size image"}</a></figcaption>
        </figure>
      </div>
    </section>
  )}

  <section class="band" id="problem" aria-labelledby="problem-t">
    <div class="split">
      <div>
        <h2 id="problem-t" class="display display-s">The problem</h2>
        <p class="people">{p.people}</p>
      </div>
      <div><p>{p.problem}</p></div>
    </div>
  </section>

  <section class="band" id="built" aria-labelledby="built-t">
    <div class="split">
      <div><h2 id="built-t" class="display display-s">What I built</h2></div>
      <div><p>{p.built}</p></div>
    </div>
    {PIPELINES[p.slug] && (
      <div class="inner pipe-wrap">
        <Pipeline stages={PIPELINES[p.slug]} label={`${p.name}: the pipeline, stage by stage`} />
      </div>
    )}
  </section>

  <section class="band" id="decisions" aria-labelledby="decisions-t">
    <div class="inner">
      <h2 id="decisions-t" class="display display-s">Decisions worth defending</h2>
      <ol class="decisions">
        {p.decisions.map((d) => <li>{d}</li>)}
      </ol>
    </div>
  </section>

  <section class="band" id="results" aria-labelledby="results-t">
    <div class="inner">
      <h2 id="results-t" class="display display-m">Results</h2>
      {fig && (
        <div class="poster-frame">
          <p class="cap">{fig.caption}</p>
          {p.slug === "prior-auth" && <PaGates />}
          {p.slug === "10k-risk" && <StabilityDots />}
          {p.slug === "nda-triage" && <NdaSweep />}
          {p.slug === "calibration" && <CoverageBand />}
          {p.slug === "learning-harness" && <GraderPaths />}
          <p class="cap">{fig.note}</p>
        </div>
      )}
      {tables.map((table) => <ResultsTable table={table} />)}
    </div>
  </section>

  <section class="band verdict" data-field={p.ink} id="finding" aria-labelledby="finding-t">
    <div class="inner">
      <h2 id="finding-t" class="display display-m">{p.launch.label}</h2>
      <p class="verdict-gate num">{p.launch.gate}</p>
      <p class="verdict-body measure">{p.finding}</p>
      <a class="pill solid" href={`/projects/${p.slug}/launch-decision-memo/`}>Read the reasoning</a>
    </div>
  </section>


  {FIXES[p.slug] && (
    <section class="band fix" data-field={p.ink} id="fixes" aria-labelledby="fixes-t">
      <div class="inner">
        <h2 id="fixes-t" class="display display-m cut">What I would fix next</h2>
        <p class="fix-lede cut" style="--d:80ms;margin:1rem 0 0">
          The same field, one step later: the cheapest experiment that tells me
          whether the mechanism is fixable, then a re-run against a gate written
          before the numbers exist.
        </p>
        <ol class="fix-list cut" style="--d:140ms">
          {FIXES[p.slug].map((fix, j) => (
            <li>
              <span class="num fix-n">{String(j + 1).padStart(2, "0")}</span>
              <p>{fix}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="band" id="artifacts" aria-labelledby="artifacts-t">
    <div class="inner">
      <h2 id="artifacts-t" class="display display-m">The record</h2>
      <p class="cap">
        Strategy, metrics, tradeoffs, the safety review where one exists, and the
        recommendation. Every document is published, in the order worth reading them.
      </p>
      <div class="catalog">
        {artifacts.map((a, i) => (
          <a class="cell" href={hrefFor(a)}>
            <span class="code num">{String(i + 1).padStart(2, "0")}</span>
            <strong>{a.data.title}</strong>
            <small>{a.data.hook}</small>
            <span class="mins num">{readMinutes(a.body)} min</span>
          </a>
        ))}
        {p.hasReport !== false && (
          <a class="cell wide" href={p.report}>
            <span class="code num">{String(artifacts.length + 1).padStart(2, "0")}</span>
            <strong>Eval report</strong>
            <small>Every number, with its denominator and its confidence interval.</small>
            <span class="mins num">full record</span>
          </a>
        )}
      </div>
    </div>
  </section>
</Base>

<style>
  .head .inner{padding-block:clamp(2.75rem,7vw,4.75rem)}
  .head .label{margin-bottom:.9rem}
  .head-scale{display:flex;align-items:baseline;gap:.8rem;flex-wrap:wrap;margin:1.9rem 0 0;max-width:36rem}
  .head-fig{font-size:clamp(2rem,5vw,3rem);font-variation-settings:"wght" 700;letter-spacing:-.04em;line-height:1}
  .head-scale span:last-child{font-size:.95rem;line-height:1.4}

  /* The two-minute walkthrough: one skim layer, five stops, seams drawn. */
  .walk .inner{padding-block:clamp(1.75rem,3.5vw,2.75rem)}
  .walk-list{
    margin:1.3rem 0 0;padding:0;list-style:none;
    display:grid;grid-template-columns:repeat(5,1fr);gap:1px;
    background:var(--rule);border:1px solid var(--rule);
  }
  .walk-list li{margin:0;display:flex}
  .walk-cell{
    display:flex;flex-direction:column;gap:.45rem;width:100%;
    background:var(--paper);padding:1.05rem 1.1rem 1.15rem;
    min-height:11rem;text-decoration:none;
    transition:background var(--t1) var(--cut),color var(--t1) var(--cut);
  }
  .walk-n{font-size:.7rem;color:var(--ink-soft);letter-spacing:.08em}
  .walk-label{
    font-family:var(--mono);font-size:.66rem;font-variation-settings:"wght" 600;
    letter-spacing:.11em;text-transform:uppercase;
  }
  [data-ink="vermilion"] .walk-label{color:var(--vermilion-deep)}
  [data-ink="chrome"] .walk-label{color:#6b5000}
  [data-ink="cobalt"] .walk-label{color:var(--cobalt-deep)}
  [data-ink="violet"] .walk-label{color:var(--violet-deep)}
  [data-ink="ink"] .walk-label{color:var(--ink)}
  .walk-cell p{margin:0;font-size:.9rem;line-height:1.5}
  .walk-cell:hover,.walk-cell:focus-visible{background:var(--ink);color:var(--paper)}
  .walk-cell:hover .walk-n,.walk-cell:hover .walk-label,
  .walk-cell:focus-visible .walk-n,.walk-cell:focus-visible .walk-label{color:inherit}
  .walk-cell:focus-visible{outline:3px solid var(--cobalt);outline-offset:-3px}
  [data-ink="chrome"] .walk-cell:focus-visible{outline-color:var(--ink)}

  .brief{margin:0;padding:0;list-style:none;display:grid;gap:1px;background:var(--rule);border:1px solid var(--rule)}
	
  .brief li{background:var(--paper);padding:1.1rem 1.25rem;line-height:1.55;font-size:.98rem}
  .brief :global(strong){font-variation-settings:"wght" 750}

  .entry-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:1px;background:var(--rule);border:1px solid var(--rule)}
  .entry{
    background:var(--paper);display:flex;flex-direction:column;gap:.4rem;
    padding:1.15rem 1.2rem;text-decoration:none;min-height:8.5rem;
    transition:background var(--t1) var(--cut),color var(--t1) var(--cut);
  }
  .entry strong{font-variation-settings:"wdth" 104,"wght" 760;font-size:1.02rem;line-height:1.2}
  .entry small{color:var(--ink-soft);line-height:1.45;font-size:.85rem;margin-top:auto}
  .entry:hover{background:var(--ink);color:var(--paper)}
  .entry:hover small{color:inherit;opacity:.8}

  .shot{margin:0;max-width:56rem}
  .shot-link{display:block}
  .shot img{display:block;width:100%;height:auto;border:1px solid var(--rule);background:var(--paper-sunk)}
  .shot figcaption{margin-top:.7rem;color:var(--ink-soft);font-size:.88rem;line-height:1.5;max-width:44rem}

  .pipe-wrap{padding-top:0;padding-bottom:clamp(2rem,4vw,3rem)}
  .people{margin:1rem 0 0;font-size:1.06rem;line-height:1.5;color:var(--vermilion-deep);max-width:32ch}
  .decisions{margin:1.4rem 0 0;padding-left:0;list-style:none;counter-reset:d;max-width:52rem}
  .decisions li{
    counter-increment:d;display:grid;grid-template-columns:2.6rem 1fr;gap:1rem;
    padding:.95rem 0;border-top:1px solid var(--rule);line-height:1.55;
  }
  .decisions li::before{
    content:counter(d,decimal-leading-zero);
    font-family:var(--mono);font-size:.78rem;color:var(--ink-soft);padding-top:.2rem;
  }
  .decisions li:last-child{border-bottom:1px solid var(--rule)}

  .verdict .inner{padding-block:clamp(3rem,7vw,5rem)}
  .verdict-gate{
    margin:1rem 0 .9rem;font-size:.78rem;letter-spacing:.13em;text-transform:uppercase;
  }
  .verdict-body{margin:0 0 1.8rem;font-size:1.1rem;line-height:1.55}
  /* What I would fix next: the verdict's field, one step later. */
  .fix .inner{padding-block:clamp(2.75rem,6vw,4.5rem)}
  .fix-lede{margin:1rem 0 0;font-size:1.02rem;line-height:1.5;color:inherit;max-width:44rem}
  .fix-list{
    margin:1.8rem 0 0;padding:0;list-style:none;
    display:grid;gap:1px;border:1px solid rgba(255,255,255,.28);
  }
  [data-field="chrome"] .fix-list{border-color:rgba(0,0,0,.22)}
  .fix-list li{
    display:grid;grid-template-columns:2.6rem 1fr;gap:1rem;
    background:rgba(255,255,255,.14);
    padding:1.05rem 1.25rem;font-size:.98rem;line-height:1.55;
  }
  [data-field="chrome"] .fix-list li{background:rgba(0,0,0,.05)}
  .fix-list p{margin:0}
