---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Mermaid from "../../../components/Mermaid.astro";
import { bySlug } from "../../../lib/site";

export async function getStaticPaths() {
  const reports = await getCollection("reports");
  return reports.map((r) => ({ params: { slug: r.data.project }, props: { entry: r } }));
}
const { entry } = Astro.props;
const p = bySlug(entry.data.project);
const { Content } = await render(entry);
const minutes = Math.max(5, Math.ceil(entry.body.trim().split(/\s+/).length / 220));
---
<Base title={`Eval report – ${p.name}`} description={`The complete evaluation record for ${p.name}.`}>
  <div class="progress" aria-hidden="true"><span></span></div>

  <header class="band head" data-field={p.ink}>
    <div class="inner">
      <p class="label">{p.name} · evaluation report · {minutes} min</p>
      <h1 class="display display-l cut">The evidence record</h1>
      <p class="takeaway cut measure" style="--d:100ms">{p.finding}</p>
    </div>
  </header>

  <div class="band">
    <div class="inner reading">
      <article class="prose"><Content /></article>
      <p class="source num">Source: {entry.data.source}</p>
      <Mermaid />
    </div>
  </div>

  <nav class="band tight ends" aria-label="Continue">
    <div class="inner">
      <a class="pill" href={`/projects/${p.slug}/#artifacts`}>All artifacts</a>
      <a class="pill" href={`/projects/${p.slug}/`}>Back to {p.name}</a>
      {p.demo && <a class="pill solid" href={p.demo.href}>Open the demo</a>}
    </div>
  </nav>
</Base>

<style>
  .progress{position:fixed;left:0;right:0;top:0;height:3px;z-index:40;background:transparent}
  .progress span{display:block;height:100%;width:0;background:var(--vermilion)}
  .head .label{margin-bottom:.9rem}
  .takeaway{
    margin:1.4rem 0 0;font-size:clamp(1.1rem,2vw,1.32rem);line-height:1.45;
    padding-left:1.1rem;border-left:1px solid currentColor;
  }
  .reading{max-width:var(--wrap)}
  .source{color:var(--ink-soft);font-size:.74rem;margin-top:3.5rem;letter-spacing:.06em}
  .ends .inner{display:flex;flex-wrap:wrap;gap:.6rem}
</style>

<script is:inline>
  (function () {
    var bar = document.querySelector(".progress span");
    if (!bar) return;
    var tick = function () {
      var max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = (max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0) + "%";
    };
    addEventListener("scroll", tick, { passive: true });
    addEventListener("resize", tick);
    tick();
  })();
</script>
