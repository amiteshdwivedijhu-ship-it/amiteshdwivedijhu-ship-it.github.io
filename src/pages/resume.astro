---
import { marked } from "marked";
import md from "../content/resume.md?raw";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
const splitAt = md.indexOf("## TECHNICAL SKILLS");
const intro = marked.parse(md.slice(0, splitAt));
const body = marked.parse(md.slice(splitAt));
---
<Base title="Resume – Amitesh Dwivedi" description="Amitesh Dwivedi, technical product manager. Agentic AI in regulated healthcare.">
  <header class="band head" data-field="ink">
    <div class="inner">
      <h1 class="display display-l cut">Resume</h1>
      <nav class="acts no-print cut" style="--d:100ms" aria-label="Resume actions">
        <button class="pill solid" id="save-pdf" type="button">Save as PDF</button>
        <button class="pill" id="copy-email" type="button" data-email="amitesh.dwivedi.jhu@gmail.com">Copy email</button>
        <a class="pill" href="https://linkedin.com/in/amiteshdwivedi/" target="_blank" rel="me noopener"><Icon name="linkedin" size={16} />LinkedIn</a>
        <a class="pill" href="https://github.com/amiteshdwivedijhu-ship-it" target="_blank" rel="me noopener"><Icon name="github" size={16} />GitHub</a>
      </nav>
    </div>
  </header>

  <section class="band tight" aria-label="Contact and summary">
    <div class="inner">
      <div class="intro" set:html={intro} />
    </div>
  </section>

  <div class="band">
    <div class="inner">
      <article class="prose resume" set:html={body} />
    </div>
  </div>
</Base>

<style>
  .head .inner{padding-block:clamp(2.5rem,6vw,4rem)}
  .acts{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.6rem}
  .acts button{cursor:pointer}

  .intro{
    display:grid;grid-template-columns:minmax(15rem,.85fr) minmax(18rem,1.35fr);
    gap:1px;background:var(--rule);border:1px solid var(--rule);
  }
  .intro :global(p){margin:0;background:var(--paper);padding:1.25rem 1.4rem;font-size:.94rem;line-height:1.55;color:var(--ink-soft)}
  .intro :global(p:first-child strong){
    display:block;color:var(--ink);font-variation-settings:"wdth" 108,"wght" 800;
    font-size:1.5rem;letter-spacing:-.03em;line-height:1.05;margin-bottom:.5rem;
  }
  .intro :global(a){overflow-wrap:anywhere}

  .resume{max-width:var(--wrap)}
  .resume :global(h2){font-size:1.18rem;margin:2.6rem 0 .8rem}
  .resume :global(h3){font-size:1.02rem}
  .resume :global(em){color:var(--ink-soft);font-style:normal;font-family:var(--mono);font-size:.82rem;letter-spacing:.02em}
  .resume :global(p),.resume :global(li){max-width:var(--measure)}
  /* The skills block reads as a set, not a paragraph, so it is set as one. */
  .resume :global(h2:first-child + ul){
    display:grid;grid-template-columns:repeat(3,1fr);gap:1px;
    background:var(--rule);border:1px solid var(--rule);
    padding:0;list-style:none;max-width:none;
  }
  .resume :global(h2:first-child + ul > li){
    margin:0;max-width:none;background:var(--paper);padding:1rem 1.15rem;
    font-size:.88rem;line-height:1.5;
  }
  .resume :global(h2:first-child + ul > li)::marker{content:none}
  .resume :global(li strong){color:var(--ink)}

  @media (max-width:760px){
    .intro{grid-template-columns:1fr}
    .resume :global(h2:first-child + ul){grid-template-columns:1fr}
  }
  @media print{
    .intro{display:block;border:0;background:none}
    .intro :global(p){padding:.2rem 0;color:#000}
    .resume :global(h2:first-child + ul){display:block;border:0;background:none}
    .resume :global(h2:first-child + ul > li){padding:.15rem 0}
  }
</style>

<script is:inline>
  document.getElementById("save-pdf")?.addEventListener("click", function () { window.print(); });
  document.getElementById("copy-email")?.addEventListener("click", async function (event) {
    var button = event.currentTarget;
    try {
      await navigator.clipboard.writeText(button.dataset.email || "");
      var original = button.textContent;
      button.textContent = "Copied";
      setTimeout(function () { button.textContent = original; }, 1800);
    } catch (err) {
      button.textContent = button.dataset.email;
    }
  });
</script>
